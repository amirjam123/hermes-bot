# ============================================
# Hermes Bot — copy to .env and fill in real values
# (The real .env must NEVER be committed to git.)
# ============================================

# Telegram Bot API token from @BotFather (format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API key from https://aistudio.google.com/apikey (format: AIza...)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Gemini model ID (fast + stable free-tier model)
GEMINI_MODEL=gemini-3.5-flash-lite

# Local keep-alive HTTP server port (Render injects PORT automatically)
PORT=3000

# Your numeric Telegram chat id (optional) — enables the daily cron status report.
# Find it by messaging the bot and checking https://api.telegram.org/bot<token>/getUpdates
HERMES_ADMIN_CHAT_ID=
